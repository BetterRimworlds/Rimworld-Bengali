  <CommandCamp>শিবির</CommandCamp>
  <!-- EN: Set up a temporary camp that can quickly be abandoned. -->
  <CommandCampDesc>তাৎক্ষণিক পরিত্যক্ত হতে পারে এমন একটি অস্থায়ী শিবির স্থাপন করুন।</CommandCampDesc>
  <!-- EN: Cannot camp here. -->
  <CommandCampFailExistingWorldObject>এখানে শিবির করা যাবে না।</CommandCampFailExistingWorldObject>
  
