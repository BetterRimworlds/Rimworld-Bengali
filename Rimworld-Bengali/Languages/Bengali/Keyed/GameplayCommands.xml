  <CommandSettleFailEnemies>এই এলাকায় শত্রু আছে।</CommandSettleFailEnemies>
  <!-- EN: Cannot settle here. -->
  <CommandSettleFailGeneric>এখানে বসতি স্থাপন করা যাবে না।</CommandSettleFailGeneric>

  <!-- Camp -->
