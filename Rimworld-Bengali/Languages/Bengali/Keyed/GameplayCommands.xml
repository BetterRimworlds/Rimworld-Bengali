  <CommandToggleDoorForbidDesc>দরজা নিষিদ্ধ করা হলে, কলোনিস্ট এবং মিত্ররা এর মধ্যে দিয়ে যাবে না। এটি শত্রু বা প্রাণীদের দরজার সাথে মিথস্ক্রিয়াকে প্রভাবিত করে না।</CommandToggleDoorForbidDesc>
  <!-- EN: Hold open -->
  <CommandToggleDoorHoldOpen>খুলে ধরুন</CommandToggleDoorHoldOpen>
  <!-- EN: When active, your colonists will not close the door after passing through. -->
  <CommandToggleDoorHoldOpenDesc>সক্রিয় হলে, আপনার কলোনিস্টরা দরজা অতিক্রম করার পরে তা বন্ধ করবে না।</CommandToggleDoorHoldOpenDesc>

  <!-- Temperature control -->
  <!-- EN: Reset -->
  <CommandResetTemp>রিসেট করুন</CommandResetTemp>
