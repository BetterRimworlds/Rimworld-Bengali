  <!-- Form caravan -->
  <!-- EN: Form caravan -->
  <CommandFormCaravan>караভান গঠন করুন</CommandFormCaravan>
  <!-- EN: Form a group of colonists able to travel to new areas. The colonists will gather all the assigned supplies and accompanying animals, leave their current area, and await further orders. -->
  <CommandFormCaravanDesc>নতুন অঞ্চলে ভ্রমণ করতে সক্ষম উপনিবেশিকদের একটি দল তৈরি করুন। উপনিবেশিকরা নির্ধারিত সমস্ত সরবরাহ এবং সাথে থাকা পশু সংগ্রহ করবে, তাদের বর্তমান এলাকা ত্যাগ করবে এবং পরবর্তী নির্দেশের জন্য অপেক্ষা করবে।</CommandFormCaravanDesc>
  <!-- EN: This spot will be used as a meeting point for the caravan. All goods and animals will be brought here before leaving. -->
  <CommandFormCaravanDescAtSpot>এই স্থানটি কারওয়ানের মিলনস্থল হিসেবে ব্যবহৃত হবে। যাত্রা শুরুর আগে সমস্ত পণ্য ও পশু এখানে আনা হবে।</CommandFormCaravanDescAtSpot>
  
  <!-- Reform caravan -->
  <!-- EN: Reform caravan -->
  <CommandReformCaravan>পুনর্গঠন কাফেলা</CommandReformCaravan>
  <!-- EN: Reform a group of colonists. The colonists will leave their current area and await further orders. -->
  <CommandReformCaravanDesc>উপনিবেশকদের একটি দলকে পুনর্গঠন করুন। উপনিবেশকরা তাঁদের বর্তমান এলাকা ত্যাগ করে পরবর্তী নির্দেশের জন্য অপেক্ষা করবে।</CommandReformCaravanDesc>
  <!-- EN: There are still some enemies in this area. -->
  <CommandReformCaravanFailHostilePawns>এই এলাকায় এখনো কিছু শত্রু আছে।</CommandReformCaravanFailHostilePawns>

  <!-- Send caravan -->
  <!-- EN: Send caravan -->
  <CommandSendCaravan>বহর প্রেরণ করুন</CommandSendCaravan>
  <!-- EN: Send caravan... -->
  <CommandSendCaravanMultiple>caravan পাঠান…</CommandSendCaravanMultiple>
  <!-- EN: Send a caravan to this destination from a selected colony which can reach this location. -->
  <CommandSendCaravanDesc>এই গন্তব্যের উদ্দেশ্যে একটি নির্বাচিত কলোনি থেকে একটি বহর প্রেরণ করুন যা এই স্থানে পৌঁছাতে পারবে।</CommandSendCaravanDesc>
  <!-- EN: Your settlements have no path to this location. -->
  <CommandSendCaravanCantReach>আপনার বসতি থেকে এই স্থানে যাওয়ার কোনো পথ নেই।</CommandSendCaravanCantReach>

  <!-- Split caravan -->
