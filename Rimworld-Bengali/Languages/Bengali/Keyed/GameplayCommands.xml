  <CommandResetTempDesc>লক্ষ্য তাপমাত্রা কক্ষ তাপমাত্রায় রিসেট করা হলো।</CommandResetTempDesc>
  <!-- EN: Raise the target temperature. -->
  <CommandRaiseTempDesc>লক্ষ্য তাপমাত্রা বাড়ান।</CommandRaiseTempDesc>
  <!-- EN: Lower the target temperature. -->
  <CommandLowerTempDesc>তাপমাত্রা কমিয়ে দিন।</CommandLowerTempDesc>

  <!-- Install/reinstall -->
  <!-- EN: Install -->
  <CommandInstall>স্থাপন করুন</CommandInstall>
  <!-- EN: This item is currently packaged up for storage and transport. Use this command to install this item in a final location. -->
  <CommandInstallDesc>এই জিনিসটি বর্তমানে সংরক্ষণ ও পরিবহনের জন্য প্যাকেজ করা আছে। এই জিনিসটিকে চূড়ান্ত স্থানে স্থাপন করার জন্য এই কমান্ডটি ব্যবহার করুন।</CommandInstallDesc>
  <!-- EN: Reinstall at... -->
  <CommandReinstall>পুনরায় ইনস্টল করুন…</CommandReinstall>
  <!-- EN: Designate this item to be uninstalled and reinstalled somewhere else. -->
  <CommandReinstallDesc>এই জিনিসটিকে সরিয়ে অন্য কোথাও পুনরায় ইনস্টল করার জন্য চিহ্নিত করুন।</CommandReinstallDesc>
  <!-- EN: Replant -->
  <CommandReplant>পুনঃরোপণ করুন</CommandReplant>
  <!-- EN: This tree is currently packaged up for storage and transport. Use this command to replant it in a new location. -->
  <CommandReplantDesc>এই গাছটি বর্তমানে সংরক্ষণ ও পরিবহণের জন্য প্যাকেজ করা হয়েছে। নতুন স্থানে এটি রোপণ করার জন্য এই কমান্ডটি ব্যবহার করুন।</CommandReplantDesc>
  
  <!-- Trade beacon -->
  <!-- EN: Create a stockpile around this building exactly matching the shape of the beacon's launch radius. -->
  <CommandMakeBeaconStockpileDesc>এই বিল্ডিংটির চারপাশে একটি স্তূপ তৈরি করুন যা সম্পূর্ণরূপে বিকনের উৎক্ষেপণ ব্যাসার্ধের আকারের সাথে মেলে।</CommandMakeBeaconStockpileDesc>
  <!-- EN: Create stockpile -->
  <CommandMakeBeaconStockpileLabel>stockpile তৈরি করুন</CommandMakeBeaconStockpileLabel>

  <!-- Sun lamp -->
  <!-- EN: Create a growing zone around this building exactly matching the shape of the lamp's light radius. -->
  <CommandSunLampMakeGrowingZoneDesc>এই বিল্ডিংটির চারপাশে বাতির আলোর ব্যাসার্ধের সাথে হুবহু মিলে যাওয়া একটি গ্রোইং জোন তৈরি করুন।</CommandSunLampMakeGrowingZoneDesc>
  <!-- EN: Create growing zone -->
  <CommandSunLampMakeGrowingZoneLabel>চাষের ক্ষেত্র তৈরি করুন</CommandSunLampMakeGrowingZoneLabel>

  <!-- Trap -->
  <!-- EN: Auto rearm -->
  <CommandAutoRearm>স্বয়ংক্রিয় পুনঃসক্রিয়করণ</CommandAutoRearm>
  <!-- EN: If this is on, this trap will automatically be replaced after it springs. -->
  <CommandAutoRearmDesc>যদি এটি চালু থাকে, তবে এই ফাঁদটি সক্রিয় হওয়ার পরে স্বয়ংক্রিয়ভাবে প্রতিস্থাপিত হবে।</CommandAutoRearmDesc>
  
  <!-- Firefoam popper -->
  <!-- EN: Auto rebuild -->
  <CommandAutoRebuild_Building>স্বয়ংক্রিয় পুনর্নির্মাণ</CommandAutoRebuild_Building>
