  <!-- EN: Join -->
  <CommandJoinCaravan>যোগ দিন</CommandJoinCaravan>
  
  <!-- Settle -->
  <!-- EN: Settle -->
  <CommandSettle>বসতি স্থাপন করুন</CommandSettle>
  <!-- EN: Settle in this area. Your colonists will enter this area and you will be able to start building a new home. -->
  <CommandSettleDesc>এই অঞ্চলে বসতি স্থাপন করুন। আপনার উপনিবেশ স্থাপনকারীরা এই অঞ্চলে প্রবেশ করবে এবং আপনি একটি নতুন বাড়ি তৈরি করা শুরু করতে পারবেন।</CommandSettleDesc>
  <!-- EN: Your faction can only have one base. -->
  <CommandSettleFailAlreadyHaveBase>আপনার দল শুধুমাত্র একটি ঘাঁটি রাখতে পারবে।</CommandSettleFailAlreadyHaveBase>
  <!-- EN: Reached maximum number of colonies. -->
  <CommandSettleFailReachedMaximumNumberOfBases>সর্বোচ্চ সংখ্যক কলোনিReached হয়েছে।</CommandSettleFailReachedMaximumNumberOfBases>
  <!-- EN: There isn't anybody there to claim the area. -->
  <CommandSettleFailNoColonists>সেখানে এলাকাটি দাবি করার মতো কেউ নেই।</CommandSettleFailNoColonists>
