<?xml version="1.0" encoding="UTF-8"?>
<LanguageData>
  
  <!-- EN: go frenzy -->
  <Frenzy_Go.label>উন্মাদ হওয়া</Frenzy_Go.label>
  <!-- EN: Inspired: Go frenzy -->
  <Frenzy_Go.baseInspectLine>উন্মত্ত হন</Frenzy_Go.baseInspectLine>
  <!-- EN: [PAWN_pronoun] will move faster for the next 8 days. -->
  <Frenzy_Go.beginLetter>আগামী ৮ দিন দ্রুত চলাচল করবে।</Frenzy_Go.beginLetter><!-- EN: [PAWN_pronoun] will move faster for the next 8 days. -->
  <Frenzy_Go.beginLetterLabel>আগামী ৮ দিন দ্রুত গতিতে চলবে।</Frenzy_Go.beginLetterLabel>
  <!-- EN: {0} is no longer inspired (go frenzy). -->
  <Frenzy_Go.endMessage>{0} আর অনুপ্রাণিত নয় (উন্মত্ত হয়ে যান)।</Frenzy_Go.endMessage>
  
  <!-- EN: shoot frenzy -->
  <Frenzy_Shoot.label>শ্যুটিং উন্মাদনা</Frenzy_Shoot.label>
  <!-- EN: Inspired: Shoot frenzy -->
  <Frenzy_Shoot.baseInspectLine>অনুপ্রাণিত: গুলিবর্ষণ</Frenzy_Shoot.baseInspectLine>
  <!-- EN: [PAWN_pronoun] will shoot more accurately for the next 8 days. -->
  <Frenzy_Shoot.beginLetter>আগামী ৮ দিন ধরে আরও নির্ভুলভাবে গুলি চালাবে।</Frenzy_Shoot.beginLetter><!-- EN: [PAWN_pronoun] will shoot more accurately for the next 8 days. -->
  <Frenzy_Shoot.beginLetterLabel>পরের ৮ দিন নির্ভুলভাবে গুলি চালাবে।</Frenzy_Shoot.beginLetterLabel>
  <!-- EN: {0} is no longer inspired (shoot frenzy). -->
  <Frenzy_Shoot.endMessage>{0} আর অনুপ্রাণিত নয় (গুলি চালানোর উন্মাদনা)।</Frenzy_Shoot.endMessage>
  
